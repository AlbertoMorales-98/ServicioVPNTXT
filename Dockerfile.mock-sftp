FROM maven:3.9.9-eclipse-temurin-21 AS build
WORKDIR /build

COPY pom.xml .
RUN mvn -q -DskipTests org.apache.maven.plugins:maven-dependency-plugin:3.6.1:go-offline

COPY src ./src
RUN mvn -q -DskipTests package org.apache.maven.plugins:maven-dependency-plugin:3.6.1:copy-dependencies

FROM eclipse-temurin:21-jre
WORKDIR /app

COPY --from=build /build/target/classes ./classes
COPY --from=build /build/target/dependency ./libs

EXPOSE 2222

ENTRYPOINT ["java","-cp","/app/classes:/app/libs/*","com.enviotxt.sftp.mockserver.SftpMockServerApplication"]
